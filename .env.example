# Copy to .env and adjust. Every platform setting uses the MODERNISATION_ prefix so that ambient
# credentials (for example a CI runner's GITHUB_TOKEN) are never picked up by accident.

# --- database (docker compose sets this for containers) ---------------------------------------------------
# MODERNISATION_DATABASE_URL=postgresql+psycopg://modernisation:modernisation-dev@127.0.0.1:5432/modernisation
POSTGRES_PASSWORD=modernisation-dev

# --- model endpoint ----------------------------------------------------------------------------------------
# Local llama.cpp server (scripts/local_model_server.sh start 1.5b):
MODERNISATION_MODEL_PROVIDER=openai_compatible
MODERNISATION_MODEL_BASE_URL=http://host.docker.internal:8081/v1
MODERNISATION_MODEL_NAME=qwen2.5-coder-1.5b-instruct-q4_k_m
MODERNISATION_MODEL_STRUCTURED_OUTPUT=json_object_schema
# Hosted OpenAI-compatible endpoint example:
# MODERNISATION_MODEL_BASE_URL=https://api.openai.com/v1
# MODERNISATION_MODEL_NAME=<model id>
# MODERNISATION_MODEL_STRUCTURED_OUTPUT=json_schema
# MODERNISATION_MODEL_API_KEY=
# Anthropic:
# MODERNISATION_MODEL_PROVIDER=anthropic
# MODERNISATION_MODEL_NAME=<model id>
# MODERNISATION_MODEL_API_KEY=
# Optional pricing (USD per million tokens) so cost per accepted patch can be computed:
# MODERNISATION_MODEL_PRICE_INPUT_PER_MTOK=
# MODERNISATION_MODEL_PRICE_OUTPUT_PER_MTOK=

# --- repositories ------------------------------------------------------------------------------------------
# Host directory mounted read-only at /repositories (local repositories must live under it)
LOCAL_REPOSITORIES=./.data/repositories
# GitHub repositories (or owners) that may be registered
MODERNISATION_ALLOWED_GITHUB_REPOSITORIES=[]
# Fine-grained token scoped to the allowed repositories: contents read/write, pull requests read/write,
# commit statuses read/write, issues read.
# MODERNISATION_GITHUB_TOKEN=
# MODERNISATION_GITHUB_WEBHOOK_SECRET=
# Identity used on commits the platform creates for pull requests (use an identity you are authorised to use)
# MODERNISATION_GIT_AUTHOR_NAME=
# MODERNISATION_GIT_AUTHOR_EMAIL=

# --- API ---------------------------------------------------------------------------------------------------
# When set, mutating endpoints require "Authorization: Bearer <token>"
# MODERNISATION_API_TOKEN=

# --- execution sandbox -------------------------------------------------------------------------------------
WHEELHOUSE=./.data/wheelhouse
# MODERNISATION_SANDBOX_COMMAND_TIMEOUT_S=300
# MODERNISATION_SANDBOX_MEMORY_MB=2048
# MODERNISATION_SANDBOX_MAX_PROCESSES=256
